---
import BaseLayout from './BaseLayout.astro';
import type { Project } from '../data/projects';
import BeautyAdvisorExhibit from '../components/exhibits/BeautyAdvisorExhibit.astro';
import CreditRiskChart from '../components/exhibits/CreditRiskChart.astro';
import FraudDetectionExhibit from '../components/exhibits/FraudDetectionExhibit.astro';
import StockVolatilityChart from '../components/exhibits/StockVolatilityChart.astro';
import MetroClusteringExhibit from '../components/exhibits/MetroClusteringExhibit.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const workPath = `C:\\WORK\\${project.slug.toUpperCase().replace(/-/g, '_')}`;
---

<BaseLayout 
  title={`${project.title} | Case Study by Aryan Ashok`}
  description={project.summary}
  type="article"
>
  <script>
    document.body.classList.add('case-study');
  </script>
  <div class="case-study-page">
    <div class="container">
      <!-- Breadcrumb header -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/#projects" class="bread-back">&#x2190; RETURN TO SELECTED WORK</a>
        <span class="bread-sep" aria-hidden="true">&#x25ba;</span>
        <span class="bread-path">{workPath}</span>
      </nav>

      <!-- Memo header block -->
      <header class="memo-header panel">
        <div class="window-titlebar memo-titlebar">
          <span class="window-title">{project.slug.toUpperCase().replace(/-/g, '_')}.PRJ</span>
          <div class="memo-meta">
            <span class="meta-domain">{project.domain}</span>
            <span class="badge tag status-tag">{project.status}</span>
          </div>
        </div>
        <div class="panel__body">
          <h1 class="memo-title">{project.title}</h1>
          <p class="memo-lead">{project.oneLiner}</p>
        </div>
      </header>

      <!-- Quantitative benchmark highlights -->
      <section class="metrics-summary-section" aria-label="Key Performance Metrics">
        <h2 class="sr-only">Key Performance Metrics</h2>
        <div class="metrics-readout">
          {project.metrics.map(m => (
            <div class="readout-cell">
              <span class="metric-big-val">{m.value}</span>
              <span class="metric-big-lbl">{m.label}</span>
              <span class="metric-big-ctx">{m.context}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- Body column (readable, ~70ch) -->
      <div class="body-column">
        <!-- Executive Overview -->
        <section class="memo-section overview-section" aria-label="Overview">
          <h2 class="section-heading">Executive abstract</h2>
          <div class="prose-content">
            <p>{project.caseStudy.overview}</p>
          </div>
        </section>

        <!-- Interactive Analytical Exhibit -->
        {project.hasInteractiveExhibit && (
          <section class="memo-section exhibit-section" aria-label="Interactive Analytical Exhibit">
            <h2 class="section-heading">Empirical exhibit</h2>
            <div class="exhibit-panel panel">
              <div class="panel__body">
                {project.exhibitType === 'beauty-advisor' && <BeautyAdvisorExhibit />}
                {project.exhibitType === 'ks-scorecard' && <CreditRiskChart />}
                {project.exhibitType === 'fraud-metrics' && <FraudDetectionExhibit />}
                {project.exhibitType === 'stock-explorer' && <StockVolatilityChart />}
                {project.exhibitType === 'metro-clusters' && <MetroClusteringExhibit />}
              </div>
            </div>
          </section>
        )}

        <!-- Detailed Case Study Narrative Sections -->
        {project.caseStudy.sections.map((sec, idx) => (
          <section class="memo-section" id={sec.id}>
            <h2 class="section-heading">{sec.title}</h2>
            <div class="prose-content">
              <p>{sec.content}</p>
              {sec.highlight && (
                <aside class="memo-callout panel">
                  <span class="callout-label">KEY TAKEAWAY</span>
                  <span class="callout-text">{sec.highlight}</span>
                </aside>
              )}
            </div>
          </section>
        ))}

        <!-- Critical Retrospective -->
        <section class="memo-section retrospective-section">
          <h2 class="section-heading">What I would do differently</h2>
          <div class="prose-content">
            <p>{project.caseStudy.whatWouldDoDifferently}</p>
          </div>
        </section>

        <!-- Technology Stack Index -->
        <section class="memo-section stack-section">
          <h2 class="section-heading">Technical implementation stack</h2>
          <div class="tech-pills-row">
            {project.technologies.map(t => (
              <span class="tech-tag tag">{t}</span>
            ))}
          </div>
        </section>
      </div>

      <!-- Case Study Footer Actions -->
      <div class="memo-footer-actions panel">
        <div class="panel__body">
          <a href={project.repoUrl} target="_blank" rel="noopener noreferrer" class="btn btn--primary">
            View Repository on GitHub &#x2197;
          </a>
          {project.liveUrl && (
            <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="btn btn--secondary">
              Launch Live Deployment &#x2197;
            </a>
          )}
          <a href="/#projects" class="btn btn--secondary">
            Return to All Projects
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  body {
    /* darker scrim on case-study pages for long reading comfort */
  }

  .case-study-page {
    padding: 0;
  }

  body.case-study .retro-background__scrim {
    opacity: 0.72;
  }

  /* Breadcrumb */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-label);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: var(--space-4);
    color: var(--text-muted);
  }

  .bread-back {
    color: var(--color-ink-primary);
    text-decoration: none;
  }
  .bread-back:hover {
    color: var(--color-accent);
  }

  .bread-sep {
    color: var(--text-dim);
  }

  .bread-path {
    color: var(--color-ink-primary);
  }

  /* Memo header */
  .memo-header {
    margin-bottom: var(--space-6);
  }

  .memo-titlebar {
    justify-content: space-between;
    align-items: center;
  }

  .memo-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-xs);
  }

  .meta-domain {
    color: var(--text-muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-family: var(--font-label);
  }

  .status-tag {
    font-size: var(--text-xs);
  }

  .memo-title {
    margin: 0 0 var(--space-2) 0;
    font-size: var(--text-hero);
    letter-spacing: 0.02em;
  }

  .memo-lead {
    margin: 0;
    font-size: var(--text-lg);
    color: var(--color-ink-secondary);
    line-height: 1.5;
    max-width: 70ch;
    border-left: 2px solid var(--color-accent);
    padding-left: var(--space-4);
  }

  /* Metrics readout strip */
  .metrics-summary-section {
    margin-bottom: var(--space-8);
  }

  .metrics-readout {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--space-3);
  }

  @media (min-width: 640px) {
    .metrics-readout {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .readout-cell {
    border: 2px solid var(--color-border);
    background: var(--bg-cell);
    padding: var(--space-4);
  }

  .metric-big-val {
    font-family: var(--font-display);
    font-size: clamp(22px, 5vw, 32px);
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: 0.04em;
    line-height: 1.1;
  }

  .metric-big-lbl {
    font-family: var(--font-label);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-top: var(--space-1);
  }

  .metric-big-ctx {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-ink-secondary);
    line-height: 1.4;
    margin-top: var(--space-2);
  }

  /* Body column */
  .body-column {
    max-width: 70ch;
  }

  @media (max-width: 640px) {
    .body-column {
      max-width: 100%;
    }
  }

  /* Memo sections */
  .memo-section {
    margin-bottom: var(--space-10);
  }

  .memo-section:not(:last-child) {
    margin-bottom: var(--space-12);
  }

  .section-heading {
    margin: 0 0 var(--space-4) 0;
    font-size: var(--text-xl);
    color: var(--color-ink-primary);
    letter-spacing: 0.04em;
    border-bottom: 2px solid var(--color-border);
    padding-bottom: var(--space-1);
  }

  .prose-content {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.65;
    color: var(--color-ink-secondary);
  }

  .prose-content p {
    margin: 0 0 var(--space-4) 0;
    max-width: 70ch;
  }

  .memo-callout {
    margin: var(--space-4) 0;
  }

  .callout-label {
    font-family: var(--font-label);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    display: block;
    margin-bottom: var(--space-1);
  }

  .callout-text {
    color: var(--color-ink-primary);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  /* Exhibit panel */
  .exhibit-panel {
    margin: var(--space-4) 0 var(--space-8);
  }

  /* Tech stack */
  .tech-pills-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tech-tag {
    font-size: var(--text-xs);
    padding: 2px 8px;
    border: 2px solid var(--color-border);
    background: var(--bg-cell);
    color: var(--color-ink-secondary);
    font-family: var(--font-label);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
  }

  /* Footer actions */
  .memo-footer-actions {
    margin-top: var(--space-12);
    border-top: 0;
  }

  .memo-footer-actions .btn {
    margin-bottom: var(--space-3);
  }

  @media (min-width: 640px) {
    .memo-footer-actions {
      display: flex;
      gap: var(--space-3);
      align-items: center;
    }
    .memo-footer-actions .btn {
      margin-bottom: 0;
    }
  }

  /* Dark bordered boxes for tables/code inside exhibits */
  table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-body);
    font-size: var(--text-xs);
  }

  th, td {
    border: 2px solid var(--color-border);
    padding: var(--space-2) var(--space-3);
    text-align: left;
    color: var(--color-ink-secondary);
  }

  th {
    background: var(--bg-cell);
    color: var(--color-ink-primary);
    font-family: var(--font-label);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
</style>
