---
import BaseLayout from './BaseLayout.astro';
import type { Project } from '../data/projects';
import BeautyAdvisorExhibit from '../components/exhibits/BeautyAdvisorExhibit.astro';
import CreditRiskChart from '../components/exhibits/CreditRiskChart.astro';
import FraudDetectionExhibit from '../components/exhibits/FraudDetectionExhibit.astro';
import StockVolatilityChart from '../components/exhibits/StockVolatilityChart.astro';
import MetroClusteringExhibit from '../components/exhibits/MetroClusteringExhibit.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<BaseLayout 
  title={`${project.title} | Case Study by Aryan Ashok`}
  description={project.summary}
  type="article"
>
  <div class="case-study-page">
    <div class="container memo-container">
      <!-- Breadcrumb Navigation -->
      <nav class="breadcrumb-nav font-mono" aria-label="Breadcrumb">
        <a href="/#projects" class="back-link">
          <span aria-hidden="true">←</span> Return to Selected Work
        </a>
        <span class="sep">/</span>
        <span class="current-slug">{project.slug}</span>
      </nav>

      <!-- Memo Header Block -->
      <header class="memo-header">
        <div class="header-meta font-mono">
          <span class="meta-domain">{project.domain}</span>
          <span class={`badge badge-status ${project.status.toLowerCase().replace(' ', '-')}`}>
            <span class={`status-dot ${project.status === 'Deployed' ? 'deployed' : project.status === 'Completed' ? 'completed' : 'progress'}`}></span>
            {project.status}
          </span>
        </div>

        <h1 class="memo-title">{project.title}</h1>
        <p class="memo-lead">{project.oneLiner}</p>

        <!-- Executive Meta Ledger -->
        <div class="executive-ledger font-mono">
          <div class="ledger-item">
            <span class="ledger-label">CORE DOMAIN</span>
            <span class="ledger-val">{project.domain}</span>
          </div>
          <div class="ledger-item">
            <span class="ledger-label">DEVELOPMENT STATUS</span>
            <span class="ledger-val">{project.status}</span>
          </div>
          <div class="ledger-item">
            <span class="ledger-label">SOURCE REPOSITORY</span>
            <span class="ledger-val">
              <a href={project.repoUrl} target="_blank" rel="noopener noreferrer" class="repo-link">
                GitHub Repository ↗
              </a>
            </span>
          </div>
          {project.liveUrl && (
            <div class="ledger-item">
              <span class="ledger-label">LIVE DEPLOYMENT</span>
              <span class="ledger-val">
                <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="live-link">
                  Active Web Demo ↗
                </a>
              </span>
            </div>
          )}
        </div>
      </header>

      <!-- Quantitative Benchmark Highlights -->
      <section class="metrics-summary-section" aria-label="Key Performance Metrics">
        <h2 class="sr-only">Key Performance Metrics</h2>
        <div class="metrics-cards-grid font-mono">
          {project.metrics.map(m => (
            <div class="summary-metric-card">
              <span class="metric-big-val">{m.value}</span>
              <span class="metric-big-lbl">{m.label}</span>
              <span class="metric-big-ctx">{m.context}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- Executive Overview -->
      <section class="memo-section overview-section">
        <h2 class="section-heading font-mono">01 // EXECUTIVE ABSTRACT</h2>
        <div class="prose-content">
          <p>{project.caseStudy.overview}</p>
        </div>
      </section>

      <!-- Interactive Analytical Exhibit (Project Specific) -->
      {project.hasInteractiveExhibit && (
        <section class="memo-section exhibit-section" aria-label="Interactive Analytical Exhibit">
          <h2 class="section-heading font-mono">02 // EMPIRICAL EXHIBIT</h2>
          {project.exhibitType === 'beauty-advisor' && <BeautyAdvisorExhibit />}
          {project.exhibitType === 'ks-scorecard' && <CreditRiskChart />}
          {project.exhibitType === 'fraud-metrics' && <FraudDetectionExhibit />}
          {project.exhibitType === 'stock-explorer' && <StockVolatilityChart />}
          {project.exhibitType === 'metro-clusters' && <MetroClusteringExhibit />}
        </section>
      )}

      <!-- Detailed Case Study Narrative Sections -->
      {project.caseStudy.sections.map((sec, idx) => (
        <section class="memo-section" id={sec.id}>
          <h2 class="section-heading font-mono">
            0{idx + (project.hasInteractiveExhibit ? 3 : 2)} // {sec.title.toUpperCase()}
          </h2>
          <div class="prose-content">
            <p>{sec.content}</p>
            {sec.highlight && (
              <aside class="memo-callout font-mono">
                <span class="callout-label">KEY TAKEAWAY:</span>
                <span class="callout-text">{sec.highlight}</span>
              </aside>
            )}
          </div>
        </section>
      ))}

      <!-- Critical Retrospective (What I Would Do Differently) -->
      <section class="memo-section retrospective-section">
        <h2 class="section-heading font-mono">
          0{project.caseStudy.sections.length + (project.hasInteractiveExhibit ? 3 : 2)} // WHAT I WOULD DO DIFFERENTLY
        </h2>
        <div class="prose-content">
          <p>{project.caseStudy.whatWouldDoDifferently}</p>
        </div>
      </section>

      <!-- Technology Stack Index -->
      <section class="memo-section stack-section">
        <h2 class="section-heading font-mono">
          0{project.caseStudy.sections.length + (project.hasInteractiveExhibit ? 4 : 3)} // TECHNICAL IMPLEMENTATION STACK
        </h2>
        <div class="tech-pills-row font-mono">
          {project.technologies.map(t => (
            <span class="tech-tag">{t}</span>
          ))}
        </div>
      </section>

      <!-- Case Study Footer Actions -->
      <div class="memo-footer-actions">
        <a href={project.repoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary font-mono">
          View Repository on GitHub ↗
        </a>
        {project.liveUrl && (
          <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary font-mono">
            Launch Live Deployment ↗
          </a>
        )}
        <a href="/#projects" class="btn btn-ghost font-mono">
          Return to All Projects
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .case-study-page {
    padding: var(--space-8) 0 var(--space-16);
  }

  .memo-container {
    max-width: 860px;
  }

  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    margin-bottom: var(--space-6);
  }

  .back-link {
    color: var(--color-ink-secondary);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .sep {
    color: var(--color-border-strong);
  }

  .current-slug {
    color: var(--color-ink-muted);
  }

  /* Memo Header */
  .memo-header {
    border-bottom: 2px solid var(--color-ink-primary);
    padding-bottom: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .header-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .meta-domain {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.05em;
  }

  .memo-title {
    font-size: var(--text-hero);
    line-height: 1.15;
    margin-bottom: var(--space-3);
  }

  .memo-lead {
    font-size: var(--text-lg);
    color: var(--color-ink-secondary);
    line-height: 1.5;
    margin-bottom: var(--space-6);
  }

  .executive-ledger {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--space-3);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: var(--space-4);
    border-radius: var(--radius-sm);
  }

  @media (min-width: 640px) {
    .executive-ledger {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .ledger-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ledger-label {
    font-size: 10px;
    color: var(--color-ink-muted);
    letter-spacing: 0.05em;
  }

  .ledger-val {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-ink-primary);
  }

  .repo-link, .live-link {
    color: var(--color-accent);
    text-decoration: underline;
  }

  /* Summary Metrics Cards */
  .metrics-summary-section {
    margin-bottom: var(--space-8);
  }

  .metrics-cards-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .metrics-cards-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .summary-metric-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: var(--space-4);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .metric-big-val {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-accent);
  }

  .metric-big-lbl {
    font-size: 11px;
    font-weight: 600;
    color: var(--color-ink-primary);
    text-transform: uppercase;
  }

  .metric-big-ctx {
    font-size: 11px;
    color: var(--color-ink-muted);
    line-height: 1.4;
  }

  /* Memo Content Sections */
  .memo-section {
    margin-bottom: var(--space-8);
  }

  .section-heading {
    font-size: var(--text-xs);
    color: var(--color-accent);
    letter-spacing: 0.05em;
    font-weight: 700;
    margin-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-1);
  }

  .prose-content p {
    font-size: var(--text-base);
    line-height: 1.7;
    margin-bottom: var(--space-4);
  }

  .memo-callout {
    background: var(--color-surface-subtle);
    border-left: 3px solid var(--color-accent);
    padding: var(--space-3) var(--space-4);
    margin: var(--space-4) 0;
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  .callout-label {
    font-weight: 700;
    color: var(--color-accent);
    margin-right: var(--space-2);
  }

  .callout-text {
    color: var(--color-ink-primary);
  }

  .tech-pills-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tech-tag {
    font-size: var(--text-xs);
    padding: var(--space-1) var(--space-3);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-ink-secondary);
  }

  /* Footer Actions */
  .memo-footer-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border-strong);
    margin-top: var(--space-12);
  }
</style>
