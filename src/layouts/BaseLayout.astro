---
import '../styles/tokens.css';
import '../styles/base.css';
import '../components/dock/animated-top-dock.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CommandMenu from '../components/CommandMenu.astro';
import Toast from '../components/Toast.astro';
import RetroBackground from '../components/RetroBackground.tsx';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const { title, description, image, type } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <SEO title={title} description={description} image={image} type={type} />
    
    <!-- View Transitions API CSS Declaration -->
    <style is:global>
      @view-transition {
        navigation: auto;
      }
    </style>

  </head>
  <body>
    <!-- Retro dither field: mounted once, fixed full viewport, behind the site -->
    <RetroBackground client:visible />

    <!-- Skip to main content link (Antislop R-32, R-39) -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <Header />

    <main id="main-content" class="page-shell">
      <slot />
    </main>

    <Footer />

    <CommandMenu />
    <Toast />
  </body>
</html>
