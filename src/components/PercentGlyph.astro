---
// Pixel-art percent glyph shared by all stat values: homepage project
// cards (ProjectCard.astro) and case study metric readout
// (CaseStudyLayout.astro). Em-based sizing scales with the parent font
// size; explicit cream color keeps it identical in every context.
---

<svg class="metric-pct" viewBox="0 0 5 7" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true">
  <rect x="0" y="0" width="1" height="1" />
  <rect x="1" y="0" width="1" height="1" />
  <rect x="4" y="0" width="1" height="1" />
  <rect x="0" y="1" width="1" height="1" />
  <rect x="1" y="1" width="1" height="1" />
  <rect x="3" y="1" width="1" height="1" />
  <rect x="3" y="2" width="1" height="1" />
  <rect x="2" y="3" width="1" height="1" />
  <rect x="1" y="4" width="1" height="1" />
  <rect x="1" y="5" width="1" height="1" />
  <rect x="3" y="5" width="1" height="1" />
  <rect x="4" y="5" width="1" height="1" />
  <rect x="0" y="6" width="1" height="1" />
  <rect x="3" y="6" width="1" height="1" />
  <rect x="4" y="6" width="1" height="1" />
</svg>

<style>
  .metric-pct {
    color: var(--color-ink-primary);
    display: inline-block;
    vertical-align: baseline;
    height: 0.75em;
    width: calc(0.75em * 5 / 7);
    margin-left: 2px;
  }
</style>
