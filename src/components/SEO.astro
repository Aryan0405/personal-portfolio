---
// SEO.astro - Comprehensive metadata, Open Graph, Twitter, and Schema.org
interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article';
}

const {
  title = 'Aryan Ashok | Data Science & AI/ML Developer',
  description = 'Personal portfolio of Aryan Ashok, a Data Science & AI/ML developer in Mumbai, India. Projects across semantic search, credit risk modeling, fraud detection, stock analytics, and unsupervised sensor clustering.',
  image = '/og-image.svg',
  canonicalUrl = new URL(Astro.url.pathname, Astro.site).href,
  type = 'website'
} = Astro.props;

const siteName = 'Aryan Ashok - Portfolio';
const fullImageUrl = new URL(image, Astro.site || Astro.url.origin).href;

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  'name': 'Aryan Ashok',
  'jobTitle': 'Data Science & AI/ML Developer',
  'address': {
    '@type': 'PostalAddress',
    'addressLocality': 'Mumbai',
    'addressCountry': 'India'
  },
  'alumniOf': {
    '@type': 'EducationalOrganization',
    'name': 'School of Data Science & Business Intelligence (SDBI)'
  },
  'url': Astro.url.origin,
  'sameAs': [
    'https://github.com/Aryan0405/',
    'https://www.linkedin.com/in/aryan-ashok/'
  ]
};
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta id="theme-color-meta" name="theme-color" content="#FBF9F5" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImageUrl} />
<meta property="og:site_name" content={siteName} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={fullImageUrl} />

<!-- Sitemap & Robots -->
<link rel="sitemap" href="/sitemap.xml" />
<meta name="robots" content="index, follow" />

<!-- Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
