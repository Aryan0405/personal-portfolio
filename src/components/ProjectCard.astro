---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const fileName = project.slug.toUpperCase().replace(/-/g, ' ').replace(/_/g, ' ');
---

<article class="project-card panel" id={`project-${project.slug}`} aria-label="Case study: {project.title}">
  <div class="window-titlebar card-titlebar">
    <span class="status-tag tag">{project.status}</span>
  </div>

  <div class="panel__body">
    <h3 class="card-title text-display">{project.title}</h3>
    <p class="card-oneliner">{project.oneLiner}</p>
    <p class="card-problem">{project.problemStatement}</p>

    <div class="card-metrics">
      {project.metrics.map(m => (
        <div class="metric-cell">
          <span class="m-val">{m.value}</span>
          <span class="m-lbl">{m.label}</span>
          <span class="m-ctx">{m.context}</span>
        </div>
      ))}
    </div>

    <div class="card-tech-list">
      {project.technologies.map(tech => (
        <span class="tech-pill tag">{tech}</span>
      ))}
    </div>

    <div class="card-actions">
      <a href={`/work/${project.slug}`} class="btn btn--primary">
        Read Case Study
      </a>
      <div class="external-links">
        {project.liveUrl && (
          <a
            href={project.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--secondary"
          >
            Live Demo &#x2197;
          </a>
        )}
        <a
          href={project.repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--secondary"
        >
          GitHub &#x2197;
        </a>
      </div>
    </div>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-titlebar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
  }

  .card-titlebar .status-tag {
    margin-left: auto;
    margin-right: var(--space-2);
  }

  .card-titlebar .window-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .status-tag {
    font-size: var(--text-xs);
    padding: 0 var(--space-2);
    height: auto;
  }

  .card-title {
    margin: 0 0 var(--space-2) 0;
    font-size: var(--text-xl);
    letter-spacing: 0.04em;
  }

  .card-oneliner {
    margin: 0 0 var(--space-4) 0;
    font-size: var(--text-sm);
    color: var(--color-ink-secondary);
    line-height: 1.55;
  }

  .card-problem {
    margin: 0 0 var(--space-6) 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.55;
    font-style: italic;
  }

  .card-metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    margin: 0 0 var(--space-6) 0;
    border-top: 2px solid var(--color-border);
    border-bottom: 2px solid var(--color-border);
    padding: var(--space-3) 0;
  }

  @media (max-width: 640px) {
    .card-metrics {
      grid-template-columns: 1fr;
    }
  }

  .metric-cell {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .m-val {
    font-family: var(--font-display);
    font-size: clamp(18px, 3.6vw, 24px);
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: 0.04em;
    line-height: 1.1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .m-lbl {
    font-family: var(--font-label);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .m-ctx {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-ink-secondary);
    line-height: 1.4;
  }

  .card-tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-6) 0;
  }

  .card-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: auto;
  }

  @media (min-width: 640px) {
    .card-actions {
      flex-direction: row;
      align-items: center;
    }
    .card-actions .external-links {
      display: flex;
      gap: var(--space-3);
      margin-left: auto;
    }
  }

  .external-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .external-links a,
  .c-action-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    line-height: 1;
    vertical-align: middle;
  }

  /* Stepped hover on the whole card */
  .project-card {
    transition: border-color 0.1s steps(2), box-shadow 0.1s steps(2);
  }

  .project-card:hover,
  .project-card:focus-within {
    border-color: var(--color-accent);
    box-shadow: 8px 8px 0 rgba(6, 4, 16, 0.62);
  }
</style>
