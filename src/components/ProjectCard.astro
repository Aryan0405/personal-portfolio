---
import type { Project } from '../data/projects';
import ExternalLinkButton from '../components/ExternalLinkButton.tsx';

interface Props {
  project: Project;
}

const { project } = Astro.props;

// Shared value formatter: isolates the bare number and a trailing "%" so the
// percent glyph can be rendered inline in the pixel display font, same size
// and color as the digits. No per-value sizing — every value uses one shared
// clamp() driven by container width.
function formatValue(value: string) {
  const m = /^([±+\-]?[\d.,]+)\s*(.*)$/.exec(value.trim());
  if (!m) return { number: value, pct: false };
  return { number: m[1], pct: m[2].trim() === '%' };
}
---

<article class="project-card panel" id={`project-${project.slug}`} aria-label="Case study: {project.title}">
  <div class="window-titlebar card-titlebar">
    <span class="status-tag tag">{project.status}</span>
  </div>

  <div class="panel__body">
    <h3 class="card-title text-display">{project.title}</h3>
    <p class="card-oneliner">{project.oneLiner}</p>
    <p class="card-problem">{project.problemStatement}</p>

    <div class="card-metrics">
      {project.metrics.map((m) => {
        const { number, pct } = formatValue(m.value);
        return (
          <div class="metric-cell">
            <span class="metric-value">
              {pct ? (
                <>
                  <span class="metric-number">{number}</span>
                  <svg class="metric-pct" viewBox="0 0 7 7" width="0.8em" height="0.8em" fill="currentColor" style="vertical-align: -0.05em; display: inline-block;">
                    <rect x="1" y="1" width="1" height="1" />
                    <rect x="5" y="5" width="1" height="1" />
                    <path d="M 2 3.5 L 5 3.5" stroke="currentColor" stroke-width="1" fill="none" />
                  </svg>
                </>
              ) : (
                <span class="metric-number">{number}</span>
              )}
            </span>
            <span class="metric-label">{m.label}</span>
            <span class="metric-note">{m.context}</span>
          </div>
        );
      })}
    </div>

    <div class="card-tech-list">
      {project.technologies.map(tech => (
        <span class="tech-pill tag">{tech}</span>
      ))}
    </div>

    <div class="card-actions">
      <a href={`/work/${project.slug}`} class="btn btn--primary">
        Read Case Study
      </a>
      <div class="external-links">
        {project.liveUrl ? (
          <>
            <ExternalLinkButton href={project.liveUrl} label="Live Demo" className="btn btn--secondary" aria-label="Launch live demo for {project.title}" client:load />
            <ExternalLinkButton href={project.repoUrl} label="GitHub" className="btn btn--secondary" aria-label="View {project.title} repository on GitHub" client:load />
          </>
        ) : (
          <ExternalLinkButton href={project.repoUrl} label="GitHub" className="btn btn--secondary btn--span" aria-label="View {project.title} repository on GitHub" client:load />
        )}
      </div>
    </div>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-titlebar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
  }

  .card-titlebar .status-tag {
    margin-left: auto;
    margin-right: var(--space-2);
  }

  .card-titlebar .window-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .status-tag {
    font-size: var(--text-xs);
    padding: 0 var(--space-2);
    height: auto;
  }

  .card-title {
    margin: 0 0 var(--space-2) 0;
    font-size: var(--text-xl);
    letter-spacing: 0.04em;
    line-height: 1.1;
    min-height: 2.4em;
    overflow-wrap: anywhere;
  }

  .card-oneliner {
    margin: 0 0 var(--space-4) 0;
    font-size: var(--text-sm);
    color: var(--color-ink-secondary);
    line-height: 1.55;
    min-height: 4em;
  }

  .card-problem {
    margin: 0 0 var(--space-6) 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.55;
    font-style: italic;
    min-height: 5em;
  }

  .card-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: repeat(3, auto);
    column-gap: 16px;
    row-gap: 4px;
    margin: 0 0 var(--space-6) 0;
    border-top: 2px solid var(--color-border);
    border-bottom: 2px solid var(--color-border);
    padding: var(--space-3) 0 var(--stat-gap-bottom) 0;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  @media (max-width: 640px) {
    .card-metrics {
      grid-template-columns: 1fr;
    }
  }

  .metric-cell {
    min-width: 0;
    padding-inline-end: 4px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  @supports (grid-template-rows: subgrid) {
    @media (min-width: 641px) {
      .metric-cell {
        display: grid;
        grid-template-rows: subgrid;
        grid-row: span 3;
      }

      .metric-value {
        grid-row: 1;
        align-self: baseline;
      }

      .metric-label {
        grid-row: 2;
      }

      .metric-note {
        grid-row: 3;
      }
    }
  }

  .metric-value {
    align-self: baseline;
    display: flex;
    gap: 2px;
    align-items: baseline;
    white-space: nowrap;
    min-width: 0;
  }

  .metric-number {
    font-family: var(--font-display);
    font-size: clamp(12px, calc(100cqi / 7), 16px);
    font-weight: 700;
    color: var(--accent-yellow);
    letter-spacing: 0.04em;
    line-height: 1.1;
    white-space: nowrap;
  }

  .metric-pct {
    width: 1em;
    height: 1em;
    vertical-align: middle;
    margin-left: 2px;
  }

  .metric-label {
    grid-row: 2;
    min-width: 0;
    font-family: var(--font-label);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.4;
    min-height: 2.8em;
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
  }

  .metric-note {
    grid-row: 3;
    min-width: 0;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-ink-secondary);
    line-height: 1.4;
    min-height: 4.2em;
    overflow-wrap: anywhere;
  }

  .card-tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-6) 0;
  }

  .card-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: auto;
  }

  @media (min-width: 768px) {
    .project-card {
      max-width: 400px;
    }
  }

  .card-actions .btn {
    width: 100%;
    min-height: 44px;
    min-width: 0;
    white-space: nowrap;
  }

  .external-links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }

  .external-links .btn--span {
    grid-column: 1 / -1;
  }

  .external-links .btn-external,
  .external-links .btn--secondary {
    min-height: 44px;
    justify-content: center;
    width: 100%;
    min-width: 0;
    white-space: nowrap;
  }

  /* Stepped hover on the whole card */
  .project-card {
    transition: border-color 0.1s steps(2), box-shadow 0.1s steps(2);
  }

  .project-card:hover,
  .project-card:focus-within {
    border-color: var(--color-accent);
    box-shadow: 8px 8px 0 rgba(6, 4, 16, 0.62);
  }
</style>
