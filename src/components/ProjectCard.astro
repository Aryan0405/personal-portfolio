---
import type { Project } from '../data/projects';
import ExternalLinkButton from '../components/ExternalLinkButton.tsx';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const fileName = project.slug.toUpperCase().replace(/-/g, ' ').replace(/_/g, ' ');
---

<article class="project-card panel" id={`project-${project.slug}`} aria-label="Case study: {project.title}">
  <div class="window-titlebar card-titlebar">
    <span class="status-tag tag">{project.status}</span>
  </div>

  <div class="panel__body">
    <h3 class="card-title text-display">{project.title}</h3>
    <p class="card-oneliner">{project.oneLiner}</p>
    <p class="card-problem">{project.problemStatement}</p>

    <div class="card-metrics">
      {project.metrics.map((m) => {
        const parts = /^([±+\-]?[\d.,]+)\s*(.*)$/.exec(m.value.trim());
        const numeric = Boolean(parts);
        const number = parts ? parts[1] + (parts[2].startsWith('%') ? '%' : '') : null;
        const unit = parts && parts[2].trim() && !parts[2].startsWith('%') ? parts[2].trim() : null;
        return (
          <div class="metric-cell">
            {numeric ? (
              <div class="m-val">
                <span class="m-num">{number}</span>
                {unit ? <span class="m-unit">{unit}</span> : null}
              </div>
            ) : (
              <span class="m-val m-text">{m.value}</span>
            )}
            <span class="m-lbl">{m.label}</span>
            <span class="m-ctx">{m.context}</span>
          </div>
        );
      })}
    </div>

    <div class="card-tech-list">
      {project.technologies.map(tech => (
        <span class="tech-pill tag">{tech}</span>
      ))}
    </div>

    <div class="card-actions">
      <a href={`/work/${project.slug}`} class="btn btn--primary">
        Read Case Study
      </a>
      <div class="external-links">
        {project.liveUrl ? (
          <>
            <ExternalLinkButton href={project.liveUrl} label="Live Demo" className="btn btn--secondary btn--span" aria-label="Launch live demo for {project.title}" client:load />
            <ExternalLinkButton href={project.repoUrl} label="GitHub" className="btn btn--secondary" aria-label="View {project.title} repository on GitHub" client:load />
          </>
        ) : (
          <ExternalLinkButton href={project.repoUrl} label="GitHub" className="btn btn--secondary btn--span" aria-label="View {project.title} repository on GitHub" client:load />
        )}
      </div>
    </div>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-titlebar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
  }

  .card-titlebar .status-tag {
    margin-left: auto;
    margin-right: var(--space-2);
  }

  .card-titlebar .window-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .status-tag {
    font-size: var(--text-xs);
    padding: 0 var(--space-2);
    height: auto;
  }

  .card-title {
    margin: 0 0 var(--space-2) 0;
    font-size: var(--text-xl);
    letter-spacing: 0.04em;
  }

  .card-oneliner {
    margin: 0 0 var(--space-4) 0;
    font-size: var(--text-sm);
    color: var(--color-ink-secondary);
    line-height: 1.55;
  }

  .card-problem {
    margin: 0 0 var(--space-6) 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.55;
    font-style: italic;
  }

  .card-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 0 0 var(--space-6) 0;
    border-top: 2px solid var(--color-border);
    border-bottom: 2px solid var(--color-border);
    padding: var(--space-3) 0;
  }

  @media (max-width: 640px) {
    .card-metrics {
      grid-template-columns: 1fr;
    }
  }

  .metric-cell {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .metric-cell .m-val {
    display: flex;
    flex-direction: column;
    min-height: 2.4em;
  }

  .m-num {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    color: var(--accent-yellow);
    letter-spacing: 0.04em;
    line-height: 1.1;
    white-space: nowrap;
  }

  .m-unit {
    display: block;
    margin-top: 3px;
    font-family: var(--font-label);
    font-size: 11px;
    font-weight: 700;
    line-height: 1.1;
    color: var(--text-muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .m-val.m-text {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 700;
    color: var(--accent-yellow);
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .m-lbl {
    font-family: var(--font-label);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .m-ctx {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-ink-secondary);
    line-height: 1.4;
  }

  .card-tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-6) 0;
  }

  .card-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: auto;
  }

  .card-actions .btn {
    width: 100%;
    min-height: 44px;
    min-width: 0;
    white-space: nowrap;
  }

  .external-links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }

  .external-links .btn--span {
    grid-column: 1 / -1;
  }

  .external-links .btn-external,
  .external-links .btn--secondary {
    min-height: 44px;
    justify-content: center;
    width: 100%;
    min-width: 0;
    white-space: nowrap;
  }

  /* Stepped hover on the whole card */
  .project-card {
    transition: border-color 0.1s steps(2), box-shadow 0.1s steps(2);
  }

  .project-card:hover,
  .project-card:focus-within {
    border-color: var(--color-accent);
    box-shadow: 8px 8px 0 rgba(6, 4, 16, 0.62);
  }
</style>
