---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project-card" id={`project-${project.slug}`}>
  <div class="card-header">
    <div class="meta-row">
      <span class="domain-tag">{project.domain}</span>
      <span class={`badge badge-status ${project.status.toLowerCase().replace(' ', '-')}`}>
        <span class={`status-dot ${project.status === 'Deployed' ? 'deployed' : project.status === 'Completed' ? 'completed' : 'progress'}`}></span>
        {project.status}
      </span>
    </div>
    
    <h3 class="card-title">
      {project.title}
    </h3>
    
    <p class="card-oneliner">
      {project.oneLiner}
    </p>

    <p class="card-problem">
      {project.problemStatement}
    </p>
  </div>

  <div class="card-metrics-block">
    <div class="metrics-row">
      {project.metrics.map(m => (
        <div class="metric-item">
          <span class="m-val font-mono">{m.value}</span>
          <span class="m-lbl">{m.label}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="card-tech-list">
    {project.technologies.map(tech => (
      <span class="tech-pill">{tech}</span>
    ))}
  </div>

  <div class="card-actions">
    <a href={`/work/${project.slug}`} class="btn-read-memo">
      <span>Read Case Study</span>
      <span aria-hidden="true">→</span>
    </a>

    <div class="external-links">
      {project.liveUrl && (
        <a 
          href={project.liveUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-live"
          aria-label={`Open live deployment for ${project.title}`}
        >
          <span>Live Demo ↗</span>
        </a>
      )}
      
      <a 
        href={project.repoUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
          class="btn-repo"
        aria-label={`View GitHub repository for ${project.title}`}
      >
        <span>GitHub ↗</span>
      </a>
    </div>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    background: rgba(10, 25, 47, 0.75);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-sm);
    padding: var(--space-6);
  }

  @media (prefers-reduced-motion: no-preference) {
    .project-card {
      transition: border-color 150ms ease, box-shadow 150ms ease;
    }

    .card-title {
      transition: color 150ms ease;
    }

    .btn-read-memo {
      transition: color 150ms ease;
    }

    .btn-live, .btn-repo {
      transition: color 150ms ease;
    }
  }

  .project-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  .project-card:hover .card-title {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  .project-card:hover .btn-read-memo span[aria-hidden="true"] {
    transform: translateX(2px);
  }

  .project-card:focus-within {
    border-color: var(--color-accent);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  .btn-read-memo:focus-visible span[aria-hidden="true"] {
    transform: translateX(2px);
  }

  .card-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-1);
  }

  .domain-tag {
    font-size: var(--text-xs);
    color: var(--color-ink-secondary);
    font-weight: 500;
  }

  .card-title {
    font-size: var(--text-xl);
    line-height: 1.25;
  }

  .title-link {
    text-decoration: none;
    color: var(--color-ink-primary);
  }

  .title-link:hover {
    color: var(--color-accent);
  }

  .card-oneliner {
    font-size: var(--text-sm);
    color: var(--color-ink-secondary);
    line-height: 1.55;
    margin-top: var(--space-1);
    margin-bottom: var(--space-4);
  }

  .card-problem {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    line-height: 1.55;
    margin-top: var(--space-2);
    margin-bottom: var(--space-4);
    font-style: italic;
  }

  .card-metrics-block {
    margin: 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-3) 0;
  }

  .metrics-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
    text-align: center;
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .m-val {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-accent);
  }

  .m-lbl {
    font-size: 10px;
    color: var(--color-ink-secondary);
    letter-spacing: 0.04em;
  }

  .card-tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: var(--space-3);
    margin-bottom: 0;
    padding-bottom: var(--space-3);
  }

  .tech-pill {
    font-size: 11px;
    padding: 3px 8px;
    line-height: 1.4;
    border: 1px solid var(--color-border);
    border-radius: 0;
    color: var(--color-ink-secondary);
  }

  .card-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: auto;
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-4);
  }

  .btn-read-memo {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .btn-read-memo:hover {
    color: var(--color-accent-hover);
  }

  .btn-read-memo::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .external-links {
    position: relative;
    z-index: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .external-links a {
    cursor: pointer;
  }

  .btn-live, .btn-repo {
    font-size: var(--text-xs);
    color: var(--color-ink-secondary);
    text-decoration: none;
  }

  .btn-live {
    color: var(--color-status-deployed);
    font-weight: 600;
  }

  .btn-live:hover {
    color: #144926;
    text-decoration: underline;
  }

  .btn-repo:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }
</style>
