---
import { contactDetails, availabilityText } from '../data/projects';
const currentYear = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="container footer-wrap">
    <div class="status-readout">
      <span class="readout-label">LOC</span>
      <span class="readout-val">MUMBAI</span>
      <span class="readout-sep" aria-hidden="true">&#xb7;</span>
      <span class="readout-label">STATUS</span>
      <span class="readout-val">{availabilityText.toUpperCase()}</span>
      <span class="readout-sep" aria-hidden="true">&#xb7;</span>
      <span class="readout-label">&#x00a9; {currentYear}</span>
      <span class="readout-val">ARYAN ASHOK</span>
    </div>

    <nav class="footer-index" aria-label="Site index">
      <a href="/#projects">SELECTED PROJECTS</a>
      <a href="/#skills">TECHNICAL COMPETENCIES</a>
      <a href="/#education">ACADEMIC RECORD</a>
      <a href="/#contact">CONTACT &amp; DISPATCH</a>
    </nav>

    <div class="footer-profiles">
      <a href={contactDetails.github} target="_blank" rel="noopener noreferrer" class="footer-profile">GITHUB &#x2197;</a>
      <a href={contactDetails.linkedin} target="_blank" rel="noopener noreferrer" class="footer-profile">LINKEDIN &#x2197;</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 2px solid var(--color-border);
    background: var(--bg-panel);
  }

  .footer-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-3) 0;
  }

  @media (min-width: 768px) {
    .footer-wrap {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      padding: var(--space-3) 0;
    }
    .footer-profiles {
      margin-left: auto;
      display: flex;
      gap: var(--space-4);
      align-items: center;
    }
  }

  .status-readout {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    font-family: var(--font-label);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-body);
  }

  .readout-val {
    color: var(--color-ink-primary);
  }

  .readout-sep {
    color: var(--color-ink-secondary);
    padding: 0 2px;
  }

  .footer-index {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    list-style: none;
  }

  .footer-index a {
    font-family: var(--font-label);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-decoration: none;
    border: 2px solid transparent;
  }

  .footer-index a:hover,
  .footer-index a:focus-visible {
    color: var(--color-accent);
    border-color: var(--color-accent);
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  .footer-profile {
    font-family: var(--font-label);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-decoration: none;
    border: 2px solid var(--color-border);
    padding: 2px 8px;
  }

  .footer-profile:hover,
  .footer-profile:focus-visible {
    color: var(--color-accent);
    border-color: var(--color-accent);
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }
</style>
