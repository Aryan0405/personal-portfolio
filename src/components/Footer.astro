---
import { contactDetails } from '../data/projects';
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-top">
      <div class="footer-col">
        <span class="footer-title">Aryan Ashok</span>
        <p class="footer-desc">
          Data Science and AI/ML undergraduate at SDBI, Mumbai. Focused on machine learning systems, statistical modeling, and data engineering.
        </p>
      </div>

      <div class="footer-col">
        <span class="footer-heading font-mono">INDEX</span>
        <ul class="footer-links">
          <li><a href="/#projects">Selected Projects</a></li>
          <li><a href="/#skills">Technical Capabilities</a></li>
          <li><a href="/#education">Academic Record</a></li>
          <li><a href="/#contact">Contact &amp; Dispatch</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <span class="footer-heading font-mono">VERIFIED PROFILES</span>
        <ul class="footer-links font-mono">
          <li>
            <a href={contactDetails.github} target="_blank" rel="noopener noreferrer">
              GitHub Profile ↗
            </a>
          </li>
          <li>
            <a href={contactDetails.linkedin} target="_blank" rel="noopener noreferrer">
              LinkedIn Profile ↗
            </a>
          </li>
          <li>
            <a href={`mailto:${contactDetails.email}`}>
              Direct Email
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom font-mono">
      <div class="colophon-text">
        <span>© {currentYear} Aryan Ashok. Crafted with Astro, TypeScript, and Plain CSS.</span>
        <span class="a11y-pill">Targeting WCAG 2.2 AA Standard</span>
      </div>
      <div class="zero-track-note">
        Zero tracking scripts. Zero cookie consent banners.
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding: var(--space-12) 0 var(--space-8);
    margin-top: auto;
  }

  .footer-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .footer-top {
      grid-template-columns: 2fr 1fr 1fr;
      gap: var(--space-8);
    }
  }

  .footer-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-ink-primary);
    display: block;
    margin-bottom: var(--space-2);
  }

  .footer-desc {
    font-size: var(--text-sm);
    color: var(--color-ink-secondary);
    max-width: 380px;
    line-height: 1.6;
  }

  .footer-heading {
    font-size: 11px;
    font-weight: 600;
    color: var(--color-accent);
    display: block;
    margin-bottom: var(--space-3);
    letter-spacing: 0.05em;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-links a {
    font-size: var(--text-sm);
    color: var(--color-ink-secondary);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .footer-links a:hover {
    color: var(--color-accent);
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .colophon-text {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .a11y-pill {
    padding: 2px 6px;
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: 2px;
    font-size: 10px;
  }

  .zero-track-note {
    color: var(--color-ink-muted);
  }
</style>
