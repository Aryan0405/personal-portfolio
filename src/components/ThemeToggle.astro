---
// ThemeToggle.astro - Working light/dark mode switch with localStorage (Antislop R-21 / R-34)
---

<button 
  id="theme-toggle-btn" 
  class="theme-toggle-btn" 
  type="button" 
  aria-label="Switch to dark theme"
  title="Toggle theme (Light / Dark)"
>
  <span class="theme-icon light-icon" aria-hidden="true">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="5"></circle>
      <line x1="12" y1="1" x2="12" y2="3"></line>
      <line x1="12" y1="21" x2="12" y2="23"></line>
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
      <line x1="1" y1="12" x2="3" y2="12"></line>
      <line x1="21" y1="12" x2="23" y2="12"></line>
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
      <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
    </svg>
  </span>
  <span class="theme-icon dark-icon" aria-hidden="true">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
  </span>
</button>

<script>
  function initTheme() {
    const toggleBtn = document.getElementById('theme-toggle-btn');
    if (!toggleBtn) return;

    const html = document.documentElement;
    const isDark = html.getAttribute('data-theme') === 'dark';
    toggleBtn.setAttribute('aria-label', isDark ? 'Switch to light theme' : 'Switch to dark theme');

    toggleBtn.addEventListener('click', () => {
      const currentlyDark = html.getAttribute('data-theme') === 'dark';
      const newTheme = currentlyDark ? 'light' : 'dark';

      if (newTheme === 'dark') {
        html.setAttribute('data-theme', 'dark');
      } else {
        html.removeAttribute('data-theme');
      }
      html.style.colorScheme = newTheme;
      localStorage.setItem('theme', newTheme);
      const m = document.getElementById('theme-color-meta');
      if (m) m.setAttribute('content', newTheme === 'dark' ? '#161311' : '#FBF9F5');
      toggleBtn.setAttribute('aria-label', newTheme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
    });
  }

  initTheme();
  document.addEventListener('astro:after-swap', initTheme);
</script>

<style>
  .theme-toggle-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    min-height: 38px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-ink-secondary);
    padding: 0;
    transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
  }

  .theme-toggle-btn:hover {
    background: var(--color-surface-subtle);
    color: var(--color-ink-primary);
    border-color: var(--color-border-strong);
  }

  .light-icon {
    display: block;
  }

  .dark-icon {
    display: none;
  }

  :global([data-theme="dark"]) .light-icon {
    display: none;
  }

  :global([data-theme="dark"]) .dark-icon {
    display: block;
  }
</style>
