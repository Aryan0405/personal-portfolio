---
// Toast.astro - Accessible pixel toast notification (Antislop R-39)
---

<div id="toast-notification" class="toast-container panel" role="status" aria-live="polite" aria-atomic="true" aria-label="Notification">
  <div class="toast-content">
    <span class="toast-icon font-mono" aria-hidden="true">[OK]</span>
    <span id="toast-message">Notification message</span>
  </div>
</div>

<script>
  function initToast() {
    const toast = document.getElementById('toast-notification');
    const toastMsg = document.getElementById('toast-message');
    if (!toast || !toastMsg) return;

    let timeoutId: number | null = null;

    window.addEventListener('show-toast', (e: Event) => {
      const customEvt = e as CustomEvent<{ message: string }>;
      if (timeoutId) clearTimeout(timeoutId);

      toastMsg.textContent = customEvt.detail?.message || 'Action completed.';
      toast.classList.add('visible');

      timeoutId = window.setTimeout(() => {
        toast.classList.remove('visible');
      }, 3000);
    });
  }

  initToast();
  document.addEventListener('astro:after-swap', initToast);
</script>

<style>
  .toast-container {
    position: fixed;
    bottom: var(--space-6);
    right: var(--space-6);
    z-index: 10001;
    pointer-events: none;
    display: none;
  }

  .toast-container.visible {
    display: inline-flex;
    animation: toast-step 0.1s steps(2) both;
  }

  @keyframes toast-step {
    from { opacity: 0; transform: translate(4px, 4px); }
    to { opacity: 1; transform: translate(0, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .toast-container.visible {
      animation: none;
    }
  }

  .toast-content {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--color-frame);
    color: #0b0819;
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-label);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    box-shadow: var(--shadow-hard);
    border: 2px solid var(--color-border-strong);
  }

  .toast-icon {
    color: var(--color-accent);
  }
</style>
