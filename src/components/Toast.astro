---
// Toast.astro - Accessible notification toast (Antislop R-39)
---

<div id="toast-notification" class="toast-container" role="status" aria-live="polite" aria-atomic="true">
  <div class="toast-content font-mono">
    <span class="toast-icon font-mono" aria-hidden="true">[OK]</span>
    <span id="toast-message">Notification message</span>
  </div>
</div>

<script>
  function initToast() {
    const toast = document.getElementById('toast-notification');
    const toastMsg = document.getElementById('toast-message');
    if (!toast || !toastMsg) return;

    let timeoutId: number | null = null;

    window.addEventListener('show-toast', (e: Event) => {
      const customEvt = e as CustomEvent<{ message: string }>;
      if (timeoutId) clearTimeout(timeoutId);

      toastMsg.textContent = customEvt.detail?.message || 'Action completed.';
      toast.classList.add('visible');

      timeoutId = window.setTimeout(() => {
        toast.classList.remove('visible');
      }, 3000);
    });
  }

  initToast();
  document.addEventListener('astro:after-swap', initToast);
</script>

<style>
  .toast-container {
    position: fixed;
    bottom: var(--space-6);
    right: var(--space-6);
    z-index: 10001;
    pointer-events: none;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 200ms ease, transform 200ms ease;
  }

  .toast-container.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .toast-content {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--color-ink-primary);
    color: var(--color-bg);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  .toast-icon {
    color: var(--color-status-deployed);
    font-weight: 700;
  }
</style>
