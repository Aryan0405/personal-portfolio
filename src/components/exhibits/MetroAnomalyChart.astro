---
// MetroAnomalyChart.astro - Industrial Compressor Sensor Telemetry & Anomaly Lead Time Window
---

<div class="metro-chart-wrapper" id="metro-chart-component">
  <div class="chart-header">
    <div>
      <span class="chart-tag">Exhibit 3.1: Multivariate reconstruction</span>
      <h3 class="chart-title">Compressor Anomaly Lead-Time Window (14 Hours Prior to Failure)</h3>
    </div>
    <div class="text-xs status-note">
      <span class="status-dot progress"></span> Autoencoder MSE Threshold Breach
    </div>
  </div>

  <div class="sr-only">
    Timeline showing sensor pressure telemetry and autoencoder reconstruction error leading up to compressor failure. Normal steady pressure is maintained until T minus 14 hours, when reconstruction error breaches the threshold, providing a 14-hour preventative repair window before emergency automated shutdown.
  </div>

  <div class="canvas-container" role="region" aria-label="Compressor Telemetry Timeline">
    <svg viewBox="0 0 700 240" width="100%" height="auto" class="metro-svg">
      <!-- Grid -->
      <line x1="60" y1="30" x2="650" y2="30" stroke="var(--color-border)" stroke-dasharray="3,3" />
      <line x1="60" y1="80" x2="650" y2="80" stroke="var(--color-border)" stroke-dasharray="3,3" />
      <line x1="60" y1="130" x2="650" y2="130" stroke="var(--color-border)" stroke-dasharray="3,3" />
      <line x1="60" y1="180" x2="650" y2="180" stroke="var(--color-border-strong)" stroke-width="1.5" />

      <!-- Y Axis Labels -->
      <text x="50" y="34" class="axis-label font-mono" text-anchor="end">10 bar</text>
      <text x="50" y="84" class="axis-label font-mono" text-anchor="end">8 bar</text>
      <text x="50" y="134" class="axis-label font-mono" text-anchor="end">6 bar</text>
      <text x="50" y="184" class="axis-label font-mono" text-anchor="end">0 bar</text>

      <!-- 14-Hour Early Warning Zone (Shaded) -->
      <rect x="420" y="30" width="190" height="150" fill="var(--color-accent-subtle)" opacity="0.7" />
      <line x1="420" y1="30" x2="420" y2="180" stroke="var(--color-accent)" stroke-dasharray="4,2" />
      <line x1="610" y1="30" x2="610" y2="180" stroke="var(--color-accent)" stroke-width="2" />

      <!-- Pressure Telemetry Curve -->
      <!-- T-48h to T-14h (Normal cycling between 8 and 10 bar) -->
      <path d="
        M 60,60 Q 80,45 100,60 T 140,60 T 180,60 T 220,60 T 260,60 T 300,60 T 340,60 T 380,60 
        L 420,65 Q 460,75 500,95 Q 540,120 580,150 L 610,178 L 650,180" 
        fill="none" stroke="#4A463F" stroke-width="2.5" />

      <!-- Anomaly Reconstruction Error (Spiking after T-14h) -->
      <path d="
        M 60,175 L 140,174 L 220,175 L 300,173 L 380,174 
        L 420,165 Q 470,140 510,100 Q 560,50 610,35 L 650,30" 
        fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-dasharray="3,3" />

      <!-- Warning Annotations -->
      <text x="430" y="50" class="font-mono" font-size="11" font-weight="700" fill="var(--color-accent)">
        T-14H: ANOMALY THRESHOLD BREACH
      </text>
      <text x="430" y="68" class="font-mono" font-size="10" fill="var(--color-ink-secondary)">
        Autoencoder Error Spike (MSE > 0.082)
      </text>

      <text x="612" y="100" class="font-mono" font-size="10" font-weight="700" fill="var(--color-accent)">
        T-0: FAILURE
      </text>

      <!-- X Axis Labels -->
      <text x="60" y="205" class="axis-label font-mono" text-anchor="middle">T - 48 Hours</text>
      <text x="240" y="205" class="axis-label font-mono" text-anchor="middle">T - 30 Hours</text>
      <text x="420" y="205" class="axis-label font-mono" text-anchor="middle" font-weight="700" fill="var(--color-accent)">T - 14 Hours*</text>
      <text x="610" y="205" class="axis-label font-mono" text-anchor="middle" font-weight="700" fill="var(--color-ink-primary)">T - 0 (Failure)</text>
      <text x="355" y="230" class="axis-title font-mono" text-anchor="middle">Temporal Horizon Prior to Mechanical Failure</text>
    </svg>
  </div>

  <div class="chart-footer-metrics font-mono">
    <div class="f-metric">
      <span class="f-lbl">DETECTION LEAD TIME</span>
      <span class="f-val">14 Hours</span>
    </div>
    <div class="f-metric">
      <span class="f-lbl">PRECISION SCORE</span>
      <span class="f-val">0.91</span>
    </div>
    <div class="f-metric">
      <span class="f-lbl">FALSE POSITIVE RATE</span>
      <span class="f-val">&lt; 2.4%</span>
    </div>
  </div>
</div>

<style>
  .metro-chart-wrapper {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: var(--space-6);
    border-radius: var(--radius-sm);
    margin-top: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .chart-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-4);
  }

  @media (min-width: 768px) {
    .chart-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .chart-tag {
    font-size: var(--text-xs);
    color: var(--color-accent);
    font-weight: 600;
  }

  .chart-title {
    font-size: var(--text-xl);
    margin-top: 2px;
  }

  .status-note {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-ink-muted);
  }

  .canvas-container {
    width: 100%;
    margin: var(--space-4) 0;
  }

  .metro-svg {
    display: block;
    overflow: visible;
  }

  .axis-label {
    font-size: 11px;
    fill: var(--color-ink-muted);
  }

  .axis-title {
    font-size: 11px;
    fill: var(--color-ink-secondary);
  }

  .chart-footer-metrics {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--space-2);
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    padding: var(--space-3);
    border-radius: var(--radius-sm);
    margin-top: var(--space-2);
  }

  @media (min-width: 640px) {
    .chart-footer-metrics {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .f-metric {
    display: flex;
    flex-direction: column;
  }

  .f-lbl {
    font-size: 10px;
    color: var(--color-ink-muted);
  }

  .f-val {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-ink-primary);
  }
</style>
