---
// StockVolatilityChart.astro - Interactive Sectoral Volatility & Drawdown Matrix (NSE Stock Explorer)
const sectorData = [
  { sector: 'NIFTY Bank', vol: 18.4, return1Y: 14.2, sharpe: 0.77, maxDd: -16.8 },
  { sector: 'NIFTY IT', vol: 22.1, return1Y: 28.6, sharpe: 1.29, maxDd: -24.5 },
  { sector: 'NIFTY Auto', vol: 17.2, return1Y: 34.1, sharpe: 1.98, maxDd: -12.4 },
  { sector: 'NIFTY Pharma', vol: 13.8, return1Y: 19.5, sharpe: 1.41, maxDd: -9.8 },
  { sector: 'NIFTY Energy', vol: 20.6, return1Y: 21.0, sharpe: 1.02, maxDd: -18.2 },
  { sector: 'NIFTY FMCG', vol: 11.5, return1Y: 12.8, sharpe: 1.11, maxDd: -7.5 }
];
---

<div class="market-chart-wrapper" id="market-chart-component">
  <div class="chart-header">
    <div>
      <span class="chart-tag">Exhibit 2.1: Sectoral risk spectrum</span>
      <h3 class="chart-title">Volatility vs Return Dispersion (NIFTY Sectors)</h3>
    </div>
    <div class="text-xs status-note">
      <span class="status-dot deployed"></span> Live NSE Daily Bars (Adjusted)
    </div>
  </div>

  <div class="sr-only">
    Interactive sectoral risk comparison across NIFTY sectors. NIFTY Auto shows highest 1-year Sharpe ratio of 1.98 with 17.2% volatility, while NIFTY IT exhibits 22.1% volatility and 24.5% maximum historical drawdown.
  </div>

  <!-- Interactive visual bars -->
  <div class="sectors-grid">
    {sectorData.map(item => (
      <div class="sector-card">
        <div class="sector-top">
          <span class="sector-name">{item.sector}</span>
          <span class="sector-sharpe">Sharpe: {item.sharpe}</span>
        </div>
        
        <div class="metric-row">
          <span class="lbl">Ann. Volatility</span>
          <div class="bar-track">
            <div class="bar-fill vol" style={`width: ${(item.vol / 25) * 100}%`}></div>
          </div>
          <span class="num font-mono">{item.vol}%</span>
        </div>

        <div class="metric-row">
          <span class="lbl">1-Yr Return</span>
          <div class="bar-track">
            <div class="bar-fill ret" style={`width: ${(item.return1Y / 40) * 100}%`}></div>
          </div>
          <span class="num font-mono">{item.return1Y}%</span>
        </div>

        <div class="metric-row">
          <span class="lbl">Max Drawdown</span>
          <div class="bar-track">
            <div class="bar-fill dd" style={`width: ${(Math.abs(item.maxDd) / 30) * 100}%`}></div>
          </div>
          <span class="num alert font-mono">{item.maxDd}%</span>
        </div>
      </div>
    ))}
  </div>

  <details class="accessible-data-details">
    <summary class="font-mono">View tabular sector risk summary</summary>
    <div class="table-scroll-wrapper">
      <table class="data-table">
        <thead>
          <tr>
            <th scope="col">Sector</th>
            <th scope="col">Annualized Vol</th>
            <th scope="col">1Y Return</th>
            <th scope="col">Sharpe Ratio</th>
            <th scope="col">Max Drawdown</th>
          </tr>
        </thead>
        <tbody>
          {sectorData.map(row => (
            <tr>
              <td>{row.sector}</td>
              <td class="font-mono">{row.vol}%</td>
              <td class="font-mono">+{row.return1Y}%</td>
              <td class="font-mono">{row.sharpe}</td>
              <td class="font-mono alert-text">{row.maxDd}%</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</div>

<style>
  .market-chart-wrapper {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: var(--space-6);
    border-radius: var(--radius-sm);
    margin-top: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .chart-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-4);
  }

  @media (min-width: 768px) {
    .chart-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .chart-tag {
    font-size: var(--text-xs);
    color: var(--color-accent);
    font-weight: 600;
  }

  .chart-title {
    font-size: var(--text-xl);
    margin-top: 2px;
  }

  .status-note {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-ink-muted);
  }

  .sectors-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--space-3);
    margin: var(--space-4) 0;
  }

  @media (min-width: 640px) {
    .sectors-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .sectors-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .sector-card {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    padding: var(--space-3);
    border-radius: var(--radius-sm);
  }

  .sector-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-1);
  }

  .sector-name {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-ink-primary);
  }

  .sector-sharpe {
    font-size: 11px;
    color: var(--color-status-deployed);
    font-weight: 600;
  }

  .metric-row {
    display: grid;
    grid-template-columns: 85px 1fr 45px;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
    font-size: 11px;
  }

  .lbl {
    color: var(--color-ink-muted);
  }

  .bar-track {
    width: 100%;
    height: 6px;
    background: var(--color-border);
    border-radius: 3px;
    overflow: hidden;
  }

  .bar-fill {
    height: 100%;
    border-radius: 3px;
  }

  .bar-fill.vol { background-color: var(--color-ink-secondary); }
  .bar-fill.ret { background-color: var(--color-status-deployed); }
  .bar-fill.dd { background-color: var(--color-accent); }

  .num {
    text-align: right;
    font-weight: 600;
    color: var(--color-ink-primary);
  }

  .num.alert {
    color: var(--color-accent);
  }

  .accessible-data-details {
    margin-top: var(--space-4);
  }

  .accessible-data-details summary {
    font-size: var(--text-xs);
    color: var(--color-ink-secondary);
    padding: var(--space-2) 0;
    cursor: pointer;
  }

  .accessible-data-details summary:hover {
    color: var(--color-accent);
  }

  .table-scroll-wrapper {
    overflow-x: auto;
    margin-top: var(--space-2);
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-xs);
    text-align: right;
  }

  .data-table th, .data-table td {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .data-table th:first-child, .data-table td:first-child {
    text-align: left;
  }

  .data-table th {
    background: var(--color-surface-subtle);
    color: var(--color-ink-primary);
    font-weight: 600;
  }

  .alert-text {
    color: var(--color-accent);
  }
</style>
