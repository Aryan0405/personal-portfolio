---
import ThemeToggle from './ThemeToggle.astro';
import { contactDetails } from '../data/projects';
---

<header class="site-header">
  <div class="container header-container">
    <div class="brand-block">
      <a href="/" class="brand-link" aria-label="Aryan Ashok Portfolio Homepage">
        <span class="brand-name">Aryan Ashok</span>
        <span class="brand-role">Data Science &amp; AI/ML</span>
      </a>
    </div>

    <nav class="site-nav" aria-label="Primary navigation">
      <ul class="nav-list">
        <li><a href="/#projects" class="nav-link">Projects</a></li>
        <li><a href="/#skills" class="nav-link">Skills</a></li>
        <li><a href="/#education" class="nav-link">Education</a></li>
        <li><a href="/#contact" class="nav-link">Contact</a></li>
      </ul>
    </nav>

    <div class="header-actions">
      <button 
        type="button" 
        class="mobile-menu-toggle font-mono" 
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>

      <button 
        type="button" 
        class="cmd-trigger-btn font-mono" 
        aria-label="Open command menu palette"
        title="Open command palette"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="cmd-text" data-cmd-key>Cmd+K</span>
      </button>

      <a 
        href={contactDetails.github} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="header-github-link" 
        aria-label="Visit Aryan's GitHub Profile"
      >
        GitHub ↗
      </a>

      <ThemeToggle />
    </div>

    <!-- Mobile navigation overlay -->
    <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation">
      <div class="mobile-nav-header">
        <span class="mobile-nav-title">Menu</span>
        <button type="button" class="mobile-menu-close" aria-label="Close navigation menu" aria-controls="mobile-nav">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <ul class="mobile-nav-list">
        <li><a href="/#projects" class="mobile-nav-link">Projects</a></li>
        <li><a href="/#skills" class="mobile-nav-link">Skills</a></li>
        <li><a href="/#education" class="mobile-nav-link">Education</a></li>
        <li><a href="/#contact" class="mobile-nav-link">Contact</a></li>
      </ul>
    </nav>
    <div class="mobile-nav-backdrop" aria-hidden="true"></div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    width: 100%;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    z-index: 1000;
    backdrop-filter: blur(8px);
    transition: background-color 200ms ease, border-color 200ms ease;
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 54px;
    gap: var(--space-4);
  }

  .brand-block {
    display: flex;
    align-items: center;
  }

  .brand-link {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--color-ink-primary);
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .brand-role {
    font-size: 11px;
    color: var(--color-ink-muted);
    display: none;
  }

  @media (min-width: 640px) {
    .brand-role {
      display: inline-block;
    }
  }

  .site-nav {
    display: none;
  }

  @media (min-width: 768px) {
    .site-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    list-style: none;
  }

  .nav-link {
    font-size: var(--text-sm);
    color: var(--color-ink-secondary);
    text-decoration: none;
    font-weight: 500;
    padding: var(--space-2) 0;
    transition: color 150ms ease;
  }

  .nav-link:hover {
    color: var(--color-accent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .cmd-trigger-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 38px;
    min-height: 38px;
    padding: 0 var(--space-3);
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-ink-secondary);
    font-size: 11px;
    font-weight: 500;
    transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
  }

  .cmd-trigger-btn:hover {
    background: var(--color-surface-hover);
    color: var(--color-ink-primary);
    border-color: var(--color-border-strong);
  }

  .cmd-text {
    display: none;
  }

  @media (min-width: 480px) {
    .cmd-text {
      display: inline-block;
    }
  }

  .header-github-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 38px;
    min-height: 38px;
    padding: 0 var(--space-3);
    background: var(--color-ink-primary);
    color: var(--color-bg);
    border: 1px solid var(--color-ink-primary);
    border-radius: var(--radius-sm);
    font-size: 11px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease;
  }

  .header-github-link:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #FFFFFF;
  }

  /* Mobile menu toggle */
  .mobile-menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    min-height: 38px;
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-ink-secondary);
    padding: 0;
    transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
  }

  .mobile-menu-toggle:hover {
    background: var(--color-surface-hover);
    color: var(--color-ink-primary);
    border-color: var(--color-border-strong);
  }

  .mobile-menu-toggle[aria-expanded="true"] {
    background: var(--color-surface-hover);
    border-color: var(--color-border-strong);
  }

  /* Mobile navigation overlay */
  .mobile-nav {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: none;
    flex-direction: column;
    background: var(--color-surface);
    border-left: 1px solid var(--color-border);
    width: 100%;
    max-width: 280px;
    padding: var(--space-6);
    box-shadow: 4px 0 24px rgba(0, 0, 0, 0.08);
  }

  .mobile-nav.open {
    display: flex;
  }

  .mobile-nav-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-nav-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-ink-primary);
    letter-spacing: -0.01em;
  }

  .mobile-menu-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: transparent;
    border: none;
    color: var(--color-ink-secondary);
    padding: 0;
    cursor: pointer;
  }

  .mobile-menu-close:hover {
    color: var(--color-ink-primary);
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 0;
    margin: 0;
  }

  .mobile-nav-link {
    display: block;
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--color-ink-primary);
    text-decoration: none;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
    transition: color 150ms ease, padding-left 150ms ease;
  }

  .mobile-nav-link:hover {
    color: var(--color-accent);
    padding-left: var(--space-3);
  }

  /* Hide mobile nav on desktop */
  @media (min-width: 768px) {
    .mobile-menu-toggle {
      display: none;
    }
    .mobile-nav {
      display: none !important;
    }
  }

  /* Backdrop for mobile nav */
  .mobile-nav-backdrop {
    position: fixed;
    inset: 0;
    z-index: 1999;
    display: none;
    background: rgba(24, 23, 21, 0.3);
    backdrop-filter: blur(2px);
  }

  .mobile-nav-backdrop.open {
    display: block;
  }

  @media (min-width: 768px) {
    .mobile-nav-backdrop {
      display: none !important;
    }
  }
</style>

<script>
  (function setPlatformKeyLabel() {
    const el = document.querySelector('[data-cmd-key]');
    if (!el) return;
    const isMac = /Mac|iPod|iPhone|iPad/.test(navigator.platform);
    el.textContent = isMac ? '⌘K' : 'Ctrl+K';
  })();
</script>

<script>
  (function initMobileNav() {
    const toggleBtn = document.querySelector('.mobile-menu-toggle') as HTMLElement | null;
    const closeBtn = document.querySelector('.mobile-menu-close') as HTMLElement | null;
    const mobileNav = document.getElementById('mobile-nav') as HTMLElement | null;
    const backdrop = document.querySelector('.mobile-nav-backdrop') as HTMLElement | null;
    const navLinks = document.querySelectorAll('.mobile-nav-link');

    if (!toggleBtn || !mobileNav || !closeBtn || !backdrop) return;

    const html = document.documentElement;

    function openNav() {
      mobileNav!.classList.add('open');
      backdrop!.classList.add('open');
      toggleBtn!.setAttribute('aria-expanded', 'true');
      html.style.overflow = 'hidden';
    }

    function closeNav() {
      mobileNav!.classList.remove('open');
      backdrop!.classList.remove('open');
      toggleBtn!.setAttribute('aria-expanded', 'false');
      html.style.overflow = '';
    }

    toggleBtn.addEventListener('click', openNav);
    closeBtn.addEventListener('click', closeNav);
    backdrop.addEventListener('click', closeNav);

    navLinks.forEach(link => {
      link.addEventListener('click', closeNav);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileNav.classList.contains('open')) {
        closeNav();
      }
    });
  })();
</script>
