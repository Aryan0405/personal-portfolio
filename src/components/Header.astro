---
import { AnimatedTopDock } from './dock/AnimatedTopDock';
---

<header class="site-header">
  <AnimatedTopDock client:visible className="site-dock" />
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 50;
  }

  .site-dock {
    min-height: 48px;
  }
</style>
