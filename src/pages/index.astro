---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Portrait from '../components/Portrait.tsx';
import ExternalLinkButton from '../components/ExternalLinkButton.tsx';
import { projects, technicalSkills, academicRecord, contactDetails, availabilityText, aboutMe } from '../data/projects';
---

<BaseLayout
  title="Aryan Ashok | Data Science & AI/ML Developer"
  description="Personal portfolio of Aryan Ashok, a Data Science & AI/ML developer in Mumbai. Building semantic search systems, credit risk scorecards, fraud detection models, and financial data tools."
>
  <!-- Hero Section -->
  <section class="hero-section" aria-labelledby="hero-title">
    <div class="container">
      <div class="hero-grid">
        <!-- Portrait window -->
        <div class="portrait-window panel" role="img" aria-label="Portrait of Aryan Ashok">
          <div class="portrait-frame">
            <Portrait client:visible />
          </div>
        </div>

        <!-- Masthead window -->
        <div class="masthead panel">
          <div class="panel__body">
            <div class="status-line">
              <span class="status-text">{availabilityText}</span>
            </div>

            <h1 id="hero-title" class="hero-headline text-display">
              Aryan Ashok
              <span class="headline-sub">Data science student focused on credit risk and explainable ML.</span>
            </h1>

            <p class="hero-summary">
              I build credit-risk and fraud models and write up the trade-offs: a credit scorecard, fraud detection on 284,807 transactions, and sensor clustering on 1.5M sensor readings. Public code, live demos where they exist.
            </p>

            <div class="hero-actions">
              <a href="#projects" class="btn btn--primary">
                Explore Selected Work &#x2193;
              </a>
              <ExternalLinkButton href={contactDetails.github} label="GitHub Profile" className="btn btn--ghost" aria-label="Visit Aryan's GitHub Profile" client:load />
              <ExternalLinkButton href={contactDetails.linkedin} label="LinkedIn Profile" className="btn btn--ghost" aria-label="Visit Aryan's LinkedIn Profile" client:load />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 00 // About Section -->
  <section id="about" class="about-section" aria-labelledby="about-heading">
    <div class="container">
      <div class="about-panel panel">
        <div class="about-grid">
          <div class="about-content">
            <p class="about-lead">{aboutMe.who}</p>

          <div class="about-columns">
            <div class="about-column">
              <h3 class="about-subhead">What I build</h3>
              <p class="about-text">{aboutMe.what}</p>
            </div>
            <div class="about-column">
              <h3 class="about-subhead">What I&rsquo;m looking for</h3>
              <p class="about-text">{aboutMe.lookingFor}</p>
            </div>
          </div>

          <p class="about-text about-philosophy">
            {aboutMe.philosophy}
          </p>
        </div>

        <div class="about-profile">
          <div class="profile-card panel">
            <div class="window-titlebar profile-titlebar">
              <span class="window-title">~/PROFILE.REC</span>
            </div>
            <div class="panel__body">
              <div class="profile-field">
                <span class="profile-label">Institution</span>
                <span class="profile-val">{academicRecord.institution}</span>
              </div>
              <div class="profile-field">
                <span class="profile-label">Degree</span>
                <span class="profile-val">{academicRecord.degree}</span>
              </div>
              <div class="profile-field">
                <span class="profile-label">Status</span>
                <span class="profile-val">{academicRecord.period}</span>
              </div>
              <div class="profile-field">
                <span class="profile-label">Location</span>
                <span class="profile-val">Mumbai, India</span>
              </div>
              <div class="profile-field">
                <span class="profile-label">Availability</span>
                <span class="profile-val">{availabilityText}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  </section>

  <!-- 01 // Selected Projects Section -->
  <section id="projects" class="projects-section" aria-labelledby="projects-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="projects-heading" class="section-title">Selected Projects</h2>
        <p class="section-intro">
          Production applications, statistical pipelines, and empirical evaluations across semantic search, credit risk, fraud detection, and market data.
        </p>
      </div>

      <div class="projects-grid">
        {[...projects].sort((a, b) => a.order - b.order).map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>
  </section>

  <!-- 02 // Technical Index Section -->
  <section id="skills" class="skills-section" aria-labelledby="skills-heading">
    <div class="container">
      <div class="skills-wrapper">
        <div class="section-heading-panel">
          <h2 id="skills-heading" class="section-title">Technical Competencies</h2>
          <p class="section-intro">
            Core engineering and analytical toolkit. Organized by operational workflow rather than arbitrary percentage bars.
          </p>
        </div>

        <div class="skills-grid">
          {technicalSkills.map((cat, idx) => (
            <div class="skill-category-card panel">
              <div class="window-titlebar cat-header">
                <span class="window-title">{cat.category}</span>
              </div>
              <div class="panel__body">
                <p class="cat-desc">{cat.description}</p>
                <div class="cat-skills">
                  {cat.skills.map(s => (
                    <span class="skill-tag tag">{s}</span>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 03 // Education & Academic Context Section -->
  <section id="education" class="education-section" aria-labelledby="education-heading">
    <div class="container">
      <div class="education-wrapper">
        <div class="section-heading-panel">
          <h2 id="education-heading" class="section-title">Academic Record</h2>
          <p class="section-intro">
            Current degree coursework and foundational training in quantitative methods and computer science.
          </p>
        </div>

        <div class="academic-card panel">
          <div class="window-titlebar academic-header">
            <span class="window-title">{academicRecord.institution}</span>
            <span class="academic-period">{academicRecord.period}</span>
          </div>
          <div class="panel__body">
            <p class="academic-focus">{academicRecord.focus}</p>

            <div class="coursework-block">
              <span class="cw-title">Key coursework and foundations</span>
              <div class="cw-grid">
                {academicRecord.coursework.map(c => (
                  <div class="cw-item">
                    <span class="bullet" aria-hidden="true">&#x25aa;</span>
                    <span>{c}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 // Contact & Dispatch Section -->
  <section id="contact" class="contact-section" aria-labelledby="contact-heading">
    <div class="container">
      <div class="contact-wrap">
        <div class="panel">
          <div class="panel__body">
            <h2 id="contact-heading" class="section-title">Contact & Dispatch</h2>
            <p class="section-intro">
              {availabilityText}. Open to data science, machine learning and quantitative analytics roles.
            </p>
          </div>
        </div>

        <div class="panel">
          <div class="window-titlebar contact-header">
            <span class="window-title">~/CONTACT.DAT</span>
          </div>
          <div class="contact-body">
            <div class="contact-grid">
              <div class="contact-cell">
                <span class="contact-label">Email</span>
                <span class="contact-value">{contactDetails.email}</span>
                <button type="button" class="btn btn--primary btn-copy-email copy-email-action" data-email={contactDetails.email}>
                  Copy Email
                </button>
              </div>

              <div class="contact-cell">
                <span class="contact-label">Source repositories</span>
                <span class="contact-value">github.com/Aryan0405</span>
                <ExternalLinkButton href={contactDetails.github} label="GITHUB" className="btn btn--secondary" aria-label="Visit Aryan's GitHub repositories" client:load />
              </div>

              <div class="contact-cell">
                <span class="contact-label">Professional network</span>
                <span class="contact-value">linkedin.com/in/aryan-ashok</span>
                <ExternalLinkButton href={contactDetails.linkedin} label="LINKEDIN" className="btn btn--secondary" aria-label="Visit Aryan's LinkedIn Profile" client:load />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    function initCopyButtons() {
      const copyBtns = document.querySelectorAll('.copy-email-action');
      copyBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const email = btn.getAttribute('data-email') || 'aryan.ashok0405@gmail.com';
          navigator.clipboard.writeText(email).then(() => {
            window.dispatchEvent(new CustomEvent('show-toast', { detail: { message: 'Email copied to clipboard.' } }));
          });
        });
      });
    }

    initCopyButtons();
    document.addEventListener('astro:after-swap', initCopyButtons);
  </script>

  <style>
    /* ── Hero ─────────────────────────────────────────────────────────── */
    .hero-section {
      padding: calc(var(--nav-height) + clamp(32px, 6vh, 72px)) 0 var(--space-16);
    }

    /* Keep section titles visible under the fixed nav when anchor links are clicked */
    #projects,
    #skills,
    #education,
    #contact {
      scroll-margin-top: calc(var(--nav-height) + 24px);
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-6);
      align-items: start;
    }

    @media (min-width: 900px) {
      .hero-grid {
        grid-template-columns: 340px 1fr;
        gap: var(--space-8);
        align-items: start;
      }
    }

    /* Portrait window */
    .portrait-window {
      position: relative;
      display: flex;
      flex-direction: column;
      align-self: start;
      height: fit-content;
      padding: var(--space-4);
    }

    .portrait-frame {
      position: relative;
      width: 100%;
      aspect-ratio: 1;
      overflow: hidden;
      background: #0b0819;
    }

    /* Masthead window */
    .masthead {
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .masthead .panel__body {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: var(--space-6);
    }

    .window-titlebar {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      padding: var(--space-2) var(--space-3);
      border-bottom: 2px solid var(--color-border);
      background: var(--bg-panel-deep);
      color: var(--color-ink-primary);
      font-family: var(--font-label);
      font-size: var(--text-xs);
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .masthead .window-titlebar {
      justify-content: space-between;
    }

    .window-controls {
      display: flex;
      gap: 6px;
      margin-left: auto;
    }

    .win-control {
      width: 24px;
      height: 24px;
      padding: 0;
      border: 2px solid var(--color-border);
      border-radius: 0;
      background: var(--bg-cell);
      cursor: pointer;
    }
    .win-control:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: -2px;
    }

    .status-line {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      margin: var(--space-4) 0 var(--space-8);
      font-family: var(--font-label);
      font-size: var(--text-sm);
      letter-spacing: 0.12em;
      color: var(--accent-coral);
    }

    .hero-headline {
      margin: 0 0 var(--space-4) 0;
      color: var(--color-ink-primary);
      line-height: 1.05;
      letter-spacing: 0.02em;
    }

    .hero-headline .headline-sub {
      display: block;
      margin-top: 4px;
      font-size: var(--text-sm);
      font-weight: 400;
      color: var(--text-muted);
      letter-spacing: 0.1em;
    }

    .hero-summary {
      margin: 0 0 var(--space-6) 0;
      color: var(--color-ink-secondary);
      max-width: 60ch;
      font-size: var(--text-base);
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
      margin-bottom: var(--space-8);
    }

    .keyval-readout {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-3);
      border: 2px solid var(--color-border);
      background: var(--bg-panel-deep);
    }

    @media (min-width: 640px) {
      .keyval-readout {
        grid-template-columns: repeat(4, 1fr);
      }
    }

    .kv-cell {
      display: flex;
      flex-direction: column;
      gap: 2px;
      padding: var(--space-2);
      border-right: 2px solid var(--color-border);
      border-bottom: 2px solid var(--color-border);
    }

    .kv-cell:nth-child(4n) {
      border-right: 0;
    }
    .kv-cell:nth-last-child(-n+4) {
      border-bottom: 0;
    }

    .kv-label {
      font-family: var(--font-label);
      font-size: var(--text-xs);
      color: var(--text-muted);
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .kv-val {
      font-family: var(--font-body);
      font-size: var(--text-sm);
      color: var(--color-ink-primary);
    }

    /* ── Sections ─────────────────────────────────────────────────────── */
    .skills-section,
    .education-section,
    .contact-section {
      padding-block: clamp(56px, 10vh, 120px);
      background: transparent;
      border: none;
    }

    .projects-section {
      padding-block: clamp(56px, 10vh, 120px);
    }

    .section-heading-panel {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      padding: var(--space-4) var(--space-6);
      width: 100%;
      background: var(--bg-panel-deep);
      border: 2px solid var(--rule);
      box-shadow: var(--shadow-hard);
      margin-bottom: var(--space-8);
    }

    .section-heading-panel .section-title {
      margin: 0;
      font-size: var(--text-2xl);
    }

    .section-heading-panel .section-intro {
      margin: 0;
      font-size: var(--text-sm);
      color: var(--color-ink-secondary);
      max-width: none;
    }

    /* Section wrapper: heading panel and content panel share the same width */
    .skills-wrapper,
    .education-wrapper,
    .contact-wrapper {
      width: min(1100px, 100% - 2 * var(--page-gutter));
      margin-left: auto;
      margin-right: auto;
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
    }

    .skills-wrapper .skills-grid,
    .education-wrapper .academic-card {
      width: 100%;
      box-sizing: border-box;
    }

    .skills-wrapper .skills-grid .panel__body,
    .education-wrapper .academic-card .panel__body,
    .contact-card .panel__body {
      padding: clamp(16px, 2vw, 28px);
      box-sizing: border-box;
    }

    .section-header {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      margin-bottom: var(--space-8);
    }

    .section-title {
      margin: 0;
      font-size: var(--text-2xl);
    }

    .section-intro {
      margin: 0;
      font-size: var(--text-sm);
      color: var(--color-ink-secondary);
      max-width: 440px;
      line-height: 1.5;
    }

    /* ── About ────────────────────────────────────────────────────────── */
    .about-section {
      padding-block: clamp(40px, 6vh, 72px);
      padding-inline: clamp(20px, 4vw, 48px);
      background: transparent;
      border: none;
    }

    .about-panel {
      padding: clamp(24px, 4vh, 48px);
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    @media (min-width: 768px) {
      .about-grid {
        grid-template-columns: 1fr 340px;
        gap: var(--space-12);
        align-items: start;
      }
    }

    .about-lead {
      font-size: var(--text-lg);
      color: var(--color-ink-secondary);
      line-height: 1.65;
      margin-bottom: var(--space-8);
      max-width: 70ch;
    }

    .about-columns {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
      margin-bottom: var(--space-8);
    }

    @media (min-width: 768px) {
      .about-columns {
        flex-direction: row;
      }
    }

    .about-column {
      flex: 1 1 300px;
    }

    .about-subhead {
      font-family: var(--font-display);
      font-size: var(--text-lg);
      font-weight: 700;
      color: var(--color-ink-primary);
      margin-bottom: var(--space-3);
      letter-spacing: 0.04em;
    }

    .about-text {
      font-size: var(--text-base);
      color: var(--color-ink-secondary);
      line-height: 1.65;
      max-width: 70ch;
    }

    .about-philosophy {
      border-left: 2px solid var(--color-accent);
      padding-left: var(--space-4);
      margin-left: 0;
      max-width: 540px;
    }

    .profile-titlebar {
      justify-content: space-between;
    }

    .profile-field {
      display: flex;
      justify-content: space-between;
      gap: var(--space-4);
      padding: var(--space-2) 0;
      border-bottom: 2px solid var(--color-border);
      font-family: var(--font-body);
      font-size: var(--text-xs);
    }

    .profile-field:last-child {
      border-bottom: 0;
    }

    .profile-label {
      color: var(--text-muted);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .profile-val {
      color: var(--color-ink-primary);
      text-align: right;
    }

    /* ── Projects ─────────────────────────────────────────────────────── */
    .projects-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    @media (min-width: 768px) {
      .projects-grid {
        grid-template-columns: repeat(2, 1fr);
        justify-items: center;
      }
    }

    /* ── Skills ───────────────────────────────────────────────────────── */
    .skills-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    @media (min-width: 640px) {
      .skills-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .cat-desc {
      margin: 0 0 var(--space-4) 0;
      font-size: var(--text-sm);
      color: var(--color-ink-secondary);
      line-height: 1.5;
    }

    .cat-skills {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }

    /* ── Education ────────────────────────────────────────────────────── */
    .academic-header {
      justify-content: space-between;
    }

    .academic-period {
      font-family: var(--font-label);
      font-size: var(--text-xs);
      color: var(--text-muted);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .academic-focus {
      margin: 0 0 var(--space-6) 0;
      font-size: var(--text-base);
      color: var(--color-ink-secondary);
      line-height: 1.65;
      max-width: 70ch;
    }

    .coursework-block {
      border: 2px solid var(--color-border);
      background: var(--bg-cell);
      padding: var(--space-4);
    }

    .cw-title {
      font-family: var(--font-label);
      font-size: 11px;
      font-weight: 700;
      color: var(--color-ink-primary);
      display: block;
      margin-bottom: var(--space-3);
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .cw-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-2);
      font-size: var(--text-xs);
    }

    @media (min-width: 640px) {
      .cw-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .cw-item {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      color: var(--color-ink-secondary);
    }

    .bullet {
      color: var(--color-accent);
    }

    /* ── Contact ──────────────────────────────────────────────────────── */
    .contact-section {
      padding-bottom: var(--space-24);
    }

    .contact-wrap {
      width: min(1100px, 100% - 2 * var(--page-gutter));
      margin-inline: auto;
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
    }

    .contact-wrap > .panel {
      width: 100%;
      box-sizing: border-box;
    }

    .contact-body {
      padding: 28px;
      box-sizing: border-box;
    }

    .contact-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
      align-items: stretch;
    }

    .contact-cell {
      display: flex;
      flex-direction: column;
      gap: 12px;
      padding: 20px;
      box-sizing: border-box;
      min-width: 0;
      border: 2px solid var(--frame);
      background: var(--bg-panel-deep);
      box-shadow: 6px 6px 0 rgba(6, 4, 16, 0.62);
    }

    .contact-label {
      display: block;
      font-size: 11px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--accent-yellow);
    }

    .contact-value {
      display: block;
      font-size: 13px;
      line-height: 1.4;
      color: var(--text-cream);
      overflow-wrap: anywhere;
    }

    .contact-cell .btn {
      margin-top: auto;
      width: 100%;
      box-sizing: border-box;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.6em;
      padding: 0 16px;
      font-size: 13px;
      letter-spacing: 0.08em;
      white-space: nowrap;
    }

    @media (max-width: 900px) {
      .contact-grid {
        grid-template-columns: 1fr;
      }
      .contact-body {
        padding: 20px;
      }
    }
  </style>
</BaseLayout>
